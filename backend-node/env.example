# ========================================
# SmartExpense Node.js Backend Configuration
# ========================================

# Server Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_key_here_change_this_to_something_long_and_random
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Email Configuration (Tùy chọn - để trống nếu không muốn dùng email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=SmartExpense <noreply@smartexpense.com>

# Google OAuth Configuration (Tùy chọn)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Database Configuration (Tùy chọn - để trống để dùng in-memory)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=smartexpense

# AI Configuration
AI_MODEL_DIR=./models
DISABLE_AI=false

# ========================================
# HƯỚNG DẪN CẤU HÌNH
# ========================================
# 
# 1. Copy file này thành .env:
#    copy env.example .env
#
# 2. Chỉnh sửa các giá trị sau:
#    - JWT_SECRET: Thay đổi thành chuỗi bí mật dài và ngẫu nhiên
#    - EMAIL_USER: Email của bạn (nếu muốn dùng tính năng email)
#    - EMAIL_PASS: App Password của Gmail (không phải mật khẩu thường)
#    - GOOGLE_CLIENT_ID: Client ID từ Google Console (nếu muốn đăng nhập Google)
#
# 3. Để tạo App Password cho Gmail:
#    - Vào Google Account → Security → 2-Step Verification
#    - Bật 2-Step Verification
#    - Tạo App Password cho "Mail"
#    - Dán password 16 ký tự vào EMAIL_PASS
#
# 4. Chạy backend:
#    npm run dev
#
# ========================================
