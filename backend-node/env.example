# ========================================
# SmartExpense Node.js Backend Configuration
# ========================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_key_here_change_this_to_something_long_and_random
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=*

# Email Configuration (Tùy chọn - để trống nếu không muốn dùng email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=taosomot5017@gmail.com
EMAIL_PASS=nqdx ucxc xipt qbgz
EMAIL_FROM=SmartExpense <taosomot5017@gmail.com>

# Google OAuth Configuration (Tùy chọn)
GOOGLE_CLIENT_ID=60974853277-a0jg39ps7b4too995e58rvmehte0e16a.apps.googleusercontent.com

# Database Configuration (Tùy chọn - để trống để dùng in-memory)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=smart_expense

# AI Configuration
AI_MODEL_DIR=./models
DISABLE_AI=false

# OpenAI Configuration (Cho tính năng nhận diện giọng nói)
# Lấy API key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# OpenRouter Configuration (Cho hệ thống AI mới)
# Lấy API key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here


# TWILIO (chỉ ví dụ - thay bằng thông tin thật trong file .env của bạn)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ========================================
# HƯỚNG DẪN CẤU HÌNH
# ========================================
#
# 1. Copy file này thành .env:
#    copy env.example .env
#
# 2. Chỉnh sửa các giá trị sau:
#    - JWT_SECRET: Thay đổi thành chuỗi bí mật dài và ngẫu nhiên
#    - EMAIL_USER: Email của bạn (nếu muốn dùng tính năng email)
#    - EMAIL_PASS: App Password của Gmail (không phải mật khẩu thường)
#    - GOOGLE_CLIENT_ID: Client ID từ Google Console (nếu muốn đăng nhập Google)
#
# 3. Để tạo App Password cho Gmail:
#    - Vào Google Account → Security → 2-Step Verification
#    - Bật 2-Step Verification
#    - Tạo App Password cho "Mail"
#    - Dán password 16 ký tự vào EMAIL_PASS
#
# 4. Chạy backend:
#    npm run dev
#
# ========================================
