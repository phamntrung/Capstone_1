# ========================================
# SmartExpense Flask Backend Configuration
# ========================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=finance_ai_system

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_key_for_production

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Google OAuth Configuration (Tùy chọn)
60974853277-a0jg39ps7b4too995e58rvmehte0e16a.apps.googleusercontent.com

# ========================================
# HƯỚNG DẪN CẤU HÌNH
# ========================================
#
# 1. Copy file này thành .env:
#    copy .env.example .env
#
# 2. Chỉnh sửa các giá trị sau:
#    - DB_PASS: Mật khẩu MySQL của bạn
#    - JWT_SECRET: Thay đổi thành chuỗi bí mật dài và ngẫu nhiên
#    - GOOGLE_CLIENT_ID: Client ID từ Google Console (nếu muốn đăng nhập Google)
#
# 3. Tạo database MySQL:
#    - Tạo database tên "smartexpense"
#    - Hoặc chạy: python create_database.py
#
# 4. Chạy backend:
#    python app.py
#
# ========================================
