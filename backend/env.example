# ========================================
# SmartExpense Flask Backend Configuration
# ========================================

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Backend Flask sử dụng các biến MYSQL_* (không phải DB_*)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_expense

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secret_key_for_production

# CORS Configuration
# For development, use "*" to allow all common localhost origins
# For production, specify exact origins separated by commas: "http://example.com,https://example.com"
# Examples:
#   CORS_ORIGIN=*  (allows: localhost:8080, 127.0.0.1:8080, localhost:3000, etc.)
#   CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080  (specific origins)
CORS_ORIGIN=*

# Google OAuth Configuration (Tùy chọn)
GOOGLE_CLIENT_ID=60974853277-a0jg39ps7b4too995e58rvmehte0e16a.apps.googleusercontent.com

# ========================================
# HƯỚNG DẪN CẤU HÌNH
# ========================================
#
# 1. Copy file này thành .env:
#    copy .env.example .env
#
# 2. Chỉnh sửa các giá trị sau:
#    - MYSQL_PASSWORD: Mật khẩu MySQL của bạn (để trống nếu không có mật khẩu)
#    - MYSQL_DATABASE: Tên database (mặc định: smart_expense)
#    - JWT_SECRET: Thay đổi thành chuỗi bí mật dài và ngẫu nhiên
#    - GOOGLE_CLIENT_ID: Client ID từ Google Console (nếu muốn đăng nhập Google)
#
# 3. Tạo database MySQL:
#    - Tạo database tên "smart_expense" (hoặc tên bạn đã cấu hình)
#    - Hoặc chạy: python create_database_auto.py
#
# 4. Chạy backend:
#    python app.py
#
# ========================================
